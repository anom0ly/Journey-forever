// Cloudflare Worker for Journey Forever: serves the built site from dist/
// and the API from src/worker. Before the first deploy, create the database
// and bucket (see README) and put the database's ID below. These are the
// project's own, created 2026-10-29.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "journey-forever",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Workers Logs, plus Workers Issues: groups errors (crashes, 5xx answers,
  // console.error, and the pages' reports through /api/errors) and alerts on
  // them. Issues set in the dashboard is turned off again by a deploy unless
  // it is on here too. Source maps make its stack traces point at src/.
  "observability": { "enabled": true, "issues": { "enabled": true } },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/media/*", "/maps/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "journey-forever",
      "database_id": "8d526036-9aea-4d83-b852-d04367ca1cf3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "journey-forever-files" }],
  // Rate limits (src/worker/limits.ts). namespace_id only has to be unique
  // in the Cloudflare account. RL_REQUESTS: everything the Worker answers,
  // per IP (a journey page with many screenshots stays well under it).
  // RL_CHANGES: uploads and other changes, per account.
  "ratelimits": [
    { "name": "RL_REQUESTS", "namespace_id": "4101", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_CHANGES", "namespace_id": "4102", "simple": { "limit": 240, "period": 60 } },
    // RL_ERRORS: error reports, per uploader PC, else per account, else per IP.
    { "name": "RL_ERRORS", "namespace_id": "4103", "simple": { "limit": 10, "period": 60 } }
  ],
  // Sign-in: "battlenet" needs the BNET_CLIENT_ID and BNET_CLIENT_SECRET
  // secrets (wrangler secret put, or type "Secret" in the dashboard). For local
  // work, .dev.vars sets AUTH_MODE=dev.
  "vars": { "AUTH_MODE": "battlenet" },
  // Deploys otherwise replace every plain-text variable set in the dashboard
  // with the vars above; secrets are never touched either way.
  "keep_vars": true
}

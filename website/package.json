{
  "name": "journey-forever-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply journey-forever --local",
    "db:migrate:remote": "wrangler d1 migrations apply journey-forever --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "wrangler": "^4.156.0"
  }
}
